# Archivos que git no debe subir al repositorio

# Secretos: variables de entorno y claves (solo se sube la plantilla .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# Dependencias de Node (se instalan con npm install)
node_modules/

# Pruebas: informes de cobertura de Jest
coverage/

# Registros
*.log
npm-debug.log*

# Docker: configuración local de cada miembro
docker-compose.override.yml

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores
.idea/
.vscode/
*.swp

# Cookies de sesión guardadas al probar la API con curl
cookies.txt

# Archivos de bloqueo que crean Office y LibreOffice mientras un documento está abierto
~$*
.~lock.*#

# Plan de trabajo personal (auditoría y refactorización) y su mapa de la arquitectura,
# solo para uso local
/PLAN.md
/architecture_map.md
