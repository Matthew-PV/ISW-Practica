# Modo demo: base MySQL local (Docker, base «planb_demo») para trabajar sin la base online ni internet.
# Se carga detrás de .env, que sigue aportando el resto de variables. Los valores coinciden con
# docker-compose.yml y no son secretos. La base de las pruebas es otra («planb»), así que no se pisan.
# Uso: docker compose up -d && npm run demo:preparar && npm run dev:demo
DATABASE_URL="mysql://root:planb@localhost:3306/planb_demo"
# Sin internet no se suben fotos a Cloudinary: las cuentas demo usan la foto por defecto.
SEED_SIN_FOTOS=1
