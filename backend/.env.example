# Copiar a .env y rellenar. El archivo .env no se sube a git.

# Conexión a MySQL (los valores coinciden con docker-compose.yml)
DATABASE_URL="mysql://root:planb@localhost:3306/planb"

# Puerto del servidor
PORT=3000

# Secreto para firmar la cookie de sesión (cualquier texto largo y aleatorio)
SESSION_SECRET="cambiar-por-un-texto-largo-y-aleatorio"

# CAPTCHA del registro (Cloudflare Turnstile). Estas son las claves de prueba públicas de
# Cloudflare, que siempre aceptan: valen para desarrollo. Para desplegar, crear las reales en
# el panel de Cloudflare → Turnstile.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Credenciales de Cloudinary (Dashboard → API Keys)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Recuperación de contraseña por email (CS-64).
# Sin SMTP_URL, el email (con el enlace) se escribe en la consola del servidor: vale para desarrollo.
# Para enviarlo de verdad, poner la dirección SMTP del proveedor elegido por el equipo, por ejemplo:
# SMTP_URL="smtps://USUARIO:CLAVE@smtp.proveedor.com:465"
EMAIL_REMITENTE="PlanB <no-responder@planb.local>"
# Dirección de la web, para construir el enlace del email
URL_APP="http://localhost:3000"
