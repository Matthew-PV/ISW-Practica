// Esquema de la base de datos. Los modelos se añaden conforme se implementan
// las historias de usuario; después, `npm run db:migrate` crea la migración.

// Genera el cliente de JavaScript (@prisma/client) que usa src/repositories/shared/prisma.js
generator client {
  provider = "prisma-client-js"
}

// Base de datos MySQL; la dirección y la contraseña salen de DATABASE_URL en .env
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuario registrado. No puede haber dos con el mismo nombre de usuario ni el mismo email.
// - passwordHash: la contraseña cifrada con bcrypt (nunca se guarda la original).
// - foto: URL de la foto en Cloudinary; null mientras no suba ninguna.
// - ciudad: texto libre del perfil, distinto del catálogo Ciudad de las experiencias.
model Usuario {
  id            Int      @id @default(autoincrement())
  nombreUsuario String   @unique
  email         String   @unique
  passwordHash  String
  foto          String?
  ciudad        String?
  creadoEn      DateTime @default(now())
  experiencias  Experiencia[]
}

// Una ciudad puede tener varias experiencias. El nombre no es único:
// pueden existir ciudades distintas con el mismo nombre.
model Ciudad {
  id           Int           @id @default(autoincrement())
  nombre       String
  pais         String?
  codigoPais   String?       @db.Char(2)
  experiencias Experiencia[]

  // Las ciudades anteriores pueden seguir sin país hasta revisarse.
  @@unique([codigoPais, nombre])
}

// Cada experiencia pertenece obligatoriamente a una única ciudad existente.
model Experiencia {
  id              Int     @id @default(autoincrement())
  titulo          String
  descripcion     String  @db.Text
  ciudadId        Int
  ciudad          Ciudad  @relation(fields: [ciudadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tipo            String?
  momentoAdecuado String?
  // Solo nullable para conservar experiencias anteriores sin autor conocido.
  // La creación desde la aplicación siempre exige el usuario de la sesión.
  autorId         Int?
  autor           Usuario? @relation(fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ciudadId])
  @@index([autorId])
}

// Sesiones de express-session, guardadas por @quixo3/prisma-session-store
// (así sobreviven a los reinicios del servidor). Los campos los fija esa librería.
model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.MediumText
  expiresAt DateTime
}
