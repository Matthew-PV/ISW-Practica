{
  "name": "planb-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de PlanB: API REST y servidor de las páginas del frontend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "jest",
    "test:mysql": "node --env-file=.env node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --runInBand tests/mysql",
    "test:todo": "npm test && npm run test:mysql",
    "test:cobertura": "node --env-file=.env node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --runInBand --coverage",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env prisma/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "rootDir": "..",
    "roots": [
      "<rootDir>/backend/tests",
      "<rootDir>/backend/src",
      "<rootDir>/frontend/js"
    ],
    "setupFiles": [
      "<rootDir>/backend/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/tests/mysql/"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/server.js",
      "frontend/js/**/*.js"
    ],
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "statements": 94,
        "branches": 93,
        "functions": 95,
        "lines": 94
      }
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "bcrypt@6.0.0": true
  }
}
