{
  "name": "planb-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de PlanB: API REST y servidor de las páginas del frontend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "jest",
