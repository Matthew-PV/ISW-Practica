    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true
  }
